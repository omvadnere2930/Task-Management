# ==============================================================
# Cognevance Task Management System - Environment Variables
# ==============================================================

# Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/cognevance_task_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cognevance_task_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cognevance_task_db

# JSON Web Token Secret (Use a strong, random 32+ character string)
JWT_SECRET=super_secret_jwt_token_key_cognevance_task_manager_2026_xyz987

# JWT Token Expiry (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# Client Application URL for CORS in standalone split mode
CLIENT_URL=http://localhost:5173

# Gemini API Key (if AI features are used)
GEMINI_API_KEY=your_gemini_api_key_here
